{
  "manifest_version": 3,
  "name": "StreamVault Video Clipper & Ingest",
  "version": "1.0.0",
  "description": "1-Click video capture and permanent import into your StreamVault studio and catalog.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "*://*/*",
    "http://localhost:4000/*",
    "http://localhost:5174/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "StreamVault Video Clipper"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
